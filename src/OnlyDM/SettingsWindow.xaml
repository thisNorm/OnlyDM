<Window x:Class="OnlyDM.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OnlyDM"
        Title="OnlyDM 설정"
        Width="560" Height="680"
        MinWidth="460" MinHeight="410"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/OnlyDM.ico"
        Background="{DynamicResource ThemeWindowBrush}">
    <Window.Resources>
        <SolidColorBrush x:Key="ThemeWindowBrush" Color="#F3F5F8" />
        <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ThemeSurfaceAltBrush" Color="#EEF1F5" />
        <SolidColorBrush x:Key="ThemeTextBrush" Color="#171A21" />
        <SolidColorBrush x:Key="ThemeMutedBrush" Color="#687080" />
        <SolidColorBrush x:Key="ThemeBorderBrush" Color="#DEE3EA" />
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
        </Style>
        <SolidColorBrush x:Key="ThemeAccentBrush" Color="#4257C9" />
        <SolidColorBrush x:Key="ThemeAccentTextBrush" Color="#FFFFFF" />
        <Style x:Key="SettingsSection" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="SettingsDescription" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource ThemeMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style x:Key="SettingsGroup" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="SettingsRow" TargetType="{x:Type DockPanel}">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Margin" Value="14,7" />
        </Style>
        <Style x:Key="SettingsDivider" TargetType="{x:Type Border}">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="Margin" Value="14,0" />
        </Style>
        <Style x:Key="ChatChoice" TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Outline" CornerRadius="6" BorderThickness="1"
                                Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outline" Property="Background" Value="{DynamicResource ThemeSurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Outline" Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
                                <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeAccentTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource ThemeTextBrush}" />
                                <Setter TargetName="Outline" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChatColorField" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource ChatChoice}">
            <Setter Property="GroupName" Value="ChatColorFields" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="14" Height="14" CornerRadius="3" BorderThickness="1" Margin="0,0,6,0"
                                    Background="{Binding Tag, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                    BorderBrush="{DynamicResource ThemeMutedBrush}" />
                            <TextBlock Text="{Binding}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChatColorSwatch" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource ChatChoice}">
            <Setter Property="GroupName" Value="ChatColorSwatches" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Border Width="20" Height="20" CornerRadius="4" BorderThickness="1"
                                Background="{Binding}" BorderBrush="{DynamicResource ThemeMutedBrush}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="14,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Background="Transparent" Width="44" Height="32">
                            <Border x:Name="Track" CornerRadius="10" BorderThickness="1" Width="38" Height="20"
                                    Background="{DynamicResource ThemeSurfaceAltBrush}" BorderBrush="{DynamicResource ThemeMutedBrush}" />
                            <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="{DynamicResource ThemeMutedBrush}"
                                     HorizontalAlignment="Left" Margin="8,0,0,0" />
                            <Border x:Name="FocusRing" Visibility="Collapsed" CornerRadius="12" Width="44" Height="26"
                                    BorderThickness="1" BorderBrush="{DynamicResource ThemeAccentBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource ThemeAccentTextBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,8,0" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
            <Image Source="Assets/OnlyDM.png" Width="26" Height="26" Margin="0,0,9,0" />
            <TextBlock Text="OnlyDM 설정" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources>
                <Style x:Key="ScrollPage" TargetType="{x:Type RepeatButton}">
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                <Border Background="Transparent" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="{x:Type ScrollBar}">
                    <Setter Property="Width" Value="10" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb MinHeight="24">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="{x:Type Thumb}">
                                                    <Border Background="Transparent">
                                                        <Border x:Name="Grip" Width="5" CornerRadius="2.5"
                                                                Background="{DynamicResource ThemeMutedBrush}" Opacity="0.48" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Grip" Property="Opacity" Value="0.9" />
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="Grip" Property="Opacity" Value="0.9" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ScrollViewer.Resources>
            <StackPanel Margin="0,2,10,6">
                <TextBlock Text="알림" Style="{StaticResource SettingsSection}" Margin="0,0,0,8" />
                <Border Style="{StaticResource SettingsGroup}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource SettingsRow}">
                            <CheckBox x:Name="NotificationEnabledCheckBox" DockPanel.Dock="Right" AutomationProperties.LabeledBy="{Binding ElementName=NotificationsLabel}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="NotificationsLabel" Text="알림 받기" FontWeight="SemiBold" />
                                <TextBlock Text="새 DM이 오면 Windows 알림을 표시합니다." Style="{StaticResource SettingsDescription}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource SettingsDivider}" />
                        <DockPanel Style="{StaticResource SettingsRow}">
                            <CheckBox x:Name="WorkModeCheckBox" DockPanel.Dock="Right" AutomationProperties.LabeledBy="{Binding ElementName=WorkModeLabel}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="WorkModeLabel" Text="열일 모드" FontWeight="SemiBold" />
                                <TextBlock Text="알림 제목과 본문에서 보낸 사람과 메시지 내용을 가립니다." Style="{StaticResource SettingsDescription}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource SettingsDivider}" />
                        <DockPanel Style="{StaticResource SettingsRow}">
                            <CheckBox x:Name="NotificationPreviewCheckBox" DockPanel.Dock="Right" AutomationProperties.LabeledBy="{Binding ElementName=PreviewLabel}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="PreviewLabel" Text="알림에 메시지 내용 표시" FontWeight="SemiBold" />
                                <TextBlock Text="끄면 보낸 사람만 표시하고 내용은 숨깁니다." Style="{StaticResource SettingsDescription}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="화면 및 언어" Style="{StaticResource SettingsSection}" />
                <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="10"
                        Background="{DynamicResource ThemeSurfaceBrush}" Padding="14,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="언어" FontWeight="SemiBold" />
                            <TextBlock Text="OnlyDM과 Instagram 표시 언어를 함께 변경합니다." Style="{StaticResource SettingsDescription}" />
                        </StackPanel>
                        <Border x:Name="LanguageSelectorBorder" Grid.Column="1" CornerRadius="8" VerticalAlignment="Center"
                                Background="{DynamicResource ThemeSurfaceAltBrush}"
                                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Margin="16,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="AutoLanguageButton" Content="Auto" Width="54" Height="30" FontSize="11"
                                        BorderThickness="0" Background="Transparent" Click="AutoLanguageButton_Click" />
                                <Button x:Name="KoreanLanguageButton" Content="한국어" Width="58" Height="30" FontSize="11"
                                        BorderThickness="0" Background="Transparent" Click="KoreanLanguageButton_Click" />
                                <Button x:Name="EnglishLanguageButton" Content="English" Width="62" Height="30" FontSize="11"
                                        BorderThickness="0" Background="Transparent" Click="EnglishLanguageButton_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <TextBlock Text="채팅 테마" Style="{StaticResource SettingsSection}" Margin="0,10,0,8" />
                <Border Style="{StaticResource SettingsGroup}" Padding="14,12">
                    <StackPanel>
                        <UniformGrid Columns="3" Margin="-3,0,-3,10">
                            <RadioButton x:Name="LightThemeOption" GroupName="ChatTheme" Style="{StaticResource ChatChoice}"
                                         Content="라이트" Tag="{x:Static local:ThemeKind.Light}" />
                            <RadioButton x:Name="DarkThemeOption" GroupName="ChatTheme" Style="{StaticResource ChatChoice}"
                                         Content="다크" Tag="{x:Static local:ThemeKind.Dark}" />
                            <RadioButton x:Name="CustomThemeOption" GroupName="ChatTheme" Style="{StaticResource ChatChoice}"
                                         Content="사용자 지정" Tag="{x:Static local:ThemeKind.Custom}" />
                        </UniformGrid>

                        <Border x:Name="ChatThemePreview" CornerRadius="8" Padding="12,10"
                                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="ChatPreviewTitle" Text="채팅 미리보기" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Border x:Name="IncomingPreviewBubble" HorizontalAlignment="Left" CornerRadius="10" Padding="9,5">
                                    <TextBlock x:Name="IncomingPreviewText" Text="안녕하세요!" TextWrapping="Wrap" />
                                </Border>
                                <Border x:Name="OutgoingPreviewBubble" HorizontalAlignment="Right" CornerRadius="10" Padding="9,5" Margin="0,5,0,0">
                                    <TextBlock x:Name="OutgoingPreviewText" Text="네, 반가워요 :)" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="CustomColorsPanel" Visibility="Collapsed" Margin="0,12,0,0">
                            <UniformGrid Columns="3" Margin="-3,0,-3,0">
                                <RadioButton x:Name="BackgroundColorOption" Content="배경" IsChecked="True" Style="{StaticResource ChatColorField}" />
                                <RadioButton x:Name="IncomingColorOption" Content="받은 메시지" Style="{StaticResource ChatColorField}" />
                                <RadioButton x:Name="OutgoingColorOption" Content="보낸 메시지" Style="{StaticResource ChatColorField}" />
                            </UniformGrid>
                            <TextBlock Text="색상 팔레트" Style="{StaticResource SettingsDescription}" Margin="0,8,0,2" />
                            <WrapPanel x:Name="ColorSwatches" Margin="-2,0">
                                <RadioButton Content="#FFFFFF" Style="{StaticResource ChatColorSwatch}" />
                                <RadioButton Content="#F0F2F4" Style="{StaticResource ChatColorSwatch}" />
                                <RadioButton Content="#181C22" Style="{StaticResource ChatColorSwatch}" />
                                <RadioButton Content="#2A303A" Style="{StaticResource ChatColorSwatch}" />
                                <RadioButton Content="#4257C9" Style="{StaticResource ChatColorSwatch}" />
                                <RadioButton Content="#DBEAFE" Style="{StaticResource ChatColorSwatch}" />
                                <RadioButton Content="#DDF3E7" Style="{StaticResource ChatColorSwatch}" />
                                <RadioButton Content="#0F766E" Style="{StaticResource ChatColorSwatch}" />
                                <RadioButton Content="#A23861" Style="{StaticResource ChatColorSwatch}" />
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock x:Name="ChatHexLabel" Text="HEX 색상" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="ChatHexInput" Width="108" MinHeight="30" Padding="7,0" VerticalContentAlignment="Center"
                                         Background="{DynamicResource ThemeSurfaceBrush}" Foreground="{DynamicResource ThemeTextBrush}"
                                         BorderBrush="{DynamicResource ThemeMutedBrush}"
                                         AutomationProperties.LabeledBy="{Binding ElementName=ChatHexLabel}"
                                         AutomationProperties.HelpText="{Binding Text, ElementName=ChatHexError}" />
                            </StackPanel>
                            <TextBlock x:Name="ChatHexError" Text="#4257C9처럼 6자리 HEX 색상을 입력하세요."
                                       Style="{StaticResource SettingsDescription}" Foreground="#A4262C" Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="시작 옵션" Style="{StaticResource SettingsSection}" />
                <Border Style="{StaticResource SettingsGroup}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource SettingsRow}">
                            <CheckBox x:Name="AutoStartCheckBox" DockPanel.Dock="Right" AutomationProperties.LabeledBy="{Binding ElementName=AutoStartLabel}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="AutoStartLabel" Text="Windows 시작 시 자동 실행" FontWeight="SemiBold" />
                                <TextBlock Text="로그인하면 OnlyDM이 자동으로 실행됩니다." Style="{StaticResource SettingsDescription}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource SettingsDivider}" />
                        <DockPanel Style="{StaticResource SettingsRow}">
                            <CheckBox x:Name="StartInTrayCheckBox" DockPanel.Dock="Right" AutomationProperties.LabeledBy="{Binding ElementName=StartInTrayLabel}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="StartInTrayLabel" Text="트레이로 시작" FontWeight="SemiBold" />
                                <TextBlock Text="실행할 때 창을 열지 않고 트레이에만 둡니다." Style="{StaticResource SettingsDescription}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="계정" Style="{StaticResource SettingsSection}" />
                <Border Style="{StaticResource SettingsGroup}" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="OnlyDM에서 계정을 추가하거나 전환합니다. 로그인은 Instagram에서 진행합니다." Style="{StaticResource SettingsDescription}" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="SwitchAccountButton" Content="계정 전환" MinHeight="32" Padding="12,0" Margin="0,0,8,0" Click="SwitchAccountButton_Click" />
                            <Button x:Name="LogoutButton" Content="로그아웃" MinHeight="32" Padding="12,0" Click="LogoutButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="OnlyDM is an unofficial project and is not affiliated with Instagram or Meta."
                           Style="{StaticResource SettingsDescription}" Margin="0,14,0,2" FontSize="11" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="취소" Width="86" Height="34" Margin="0,0,8,0" IsCancel="True" />
            <Button x:Name="SaveButton" Content="저장" Width="86" Height="34" Click="SaveButton_Click" Background="#2563EB" Foreground="White" BorderThickness="0" />
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="OnlyDM.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OnlyDM 설정"
        Width="600" Height="720"
        MinWidth="600" MinHeight="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/OnlyDM.ico"
        Background="#F7F8FA">
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
            <Image Source="Assets/OnlyDM.png" Width="26" Height="26" Margin="0,0,9,0" />
            <TextBlock Text="OnlyDM 설정" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="ClassicThemeButton" Grid.Column="0" Click="ClassicThemeButton_Click" Padding="0" Background="Transparent" BorderThickness="0">
                <Border x:Name="ClassicThemeCard" BorderBrush="#F0B800" BorderThickness="2" CornerRadius="12" Padding="13" Background="#FFFFFF">
                    <StackPanel>
                        <Grid Margin="0,0,0,9">
                            <TextBlock Text="메신저 스타일" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Classic" HorizontalAlignment="Right" Foreground="#8A909A" FontSize="11" />
                        </Grid>
                        <Border x:Name="ClassicThemePreview" Height="140" Background="#B2C7D9" CornerRadius="9" Padding="11">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" Background="#FFFFFF" CornerRadius="14">
                                        <TextBlock Text="A" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#6E7B87" FontWeight="SemiBold" FontSize="11" />
                                    </Border>
                                    <StackPanel Margin="7,0,0,0">
                                        <TextBlock Text="친구" FontSize="10" Foreground="#44505A" />
                                        <Border Background="#FFFFFF" CornerRadius="7" Padding="8,5" Margin="0,3,0,0">
                                            <TextBlock Text="안녕하세요!" FontSize="11" Foreground="#191919" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Row="1" HorizontalAlignment="Right" Background="#FEE500" CornerRadius="7" Padding="8,5" Margin="0,10,0,0">
                                    <TextBlock Text="네, 반가워요 :)" FontSize="11" Foreground="#191919" />
                                </Border>
                                <TextBlock Grid.Row="2" Text="익숙한 노란 말풍선" VerticalAlignment="Bottom" HorizontalAlignment="Center" FontSize="10" Foreground="#56636E" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Button>

            <Button x:Name="DmThemeButton" Grid.Column="2" Click="DmThemeButton_Click" Padding="0" Background="Transparent" BorderThickness="0">
                <Border x:Name="DmThemeCard" BorderBrush="#E2E5EA" BorderThickness="1.5" CornerRadius="12" Padding="13" Background="#FFFFFF">
                    <StackPanel>
                        <Grid Margin="0,0,0,9">
                            <TextBlock Text="DM 스타일" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="DM" HorizontalAlignment="Right" Foreground="#8A909A" FontSize="11" />
                        </Grid>
                        <Border x:Name="DmThemePreview" Height="140" Background="#FFFFFF" BorderBrush="#ECEEF3" BorderThickness="1" CornerRadius="9" Padding="11">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" Background="#F1F2F5" CornerRadius="14">
                                        <TextBlock Text="A" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#666D78" FontWeight="SemiBold" FontSize="11" />
                                    </Border>
                                    <StackPanel Margin="7,0,0,0">
                                        <TextBlock Text="friend" FontSize="10" Foreground="#6B7280" />
                                        <Border Background="#F1F2F5" CornerRadius="12" Padding="8,5" Margin="0,3,0,0">
                                            <TextBlock Text="안녕하세요!" FontSize="11" Foreground="#151821" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Row="1" HorizontalAlignment="Right" Background="#5B5CF6" CornerRadius="12" Padding="8,5" Margin="0,10,0,0">
                                    <TextBlock Text="네, 반가워요 :)" FontSize="11" Foreground="#FFFFFF" />
                                </Border>
                                <TextBlock Grid.Row="2" Text="보라/블루 포인트" VerticalAlignment="Bottom" HorizontalAlignment="Center" FontSize="10" Foreground="#7A8191" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="2" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border BorderBrush="#E6E8EB" BorderThickness="1" CornerRadius="10" Background="#FFFFFF" Padding="14" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Windows 시작 시 자동 실행" FontWeight="SemiBold" />
                        <TextBlock Text="로그인하면 OnlyDM이 자동으로 실행됩니다." Foreground="#7A7F87" Margin="0,3,0,0" FontSize="12" />
                    </StackPanel>
                    <CheckBox x:Name="AutoStartCheckBox" Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0" />
                </Grid>
            </Border>

            <Border BorderBrush="#E6E8EB" BorderThickness="1" CornerRadius="10" Background="#FFFFFF" Padding="14" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="트레이로 시작" FontWeight="SemiBold" />
                        <TextBlock Text="실행할 때 창을 열지 않고 트레이에만 둡니다." Foreground="#7A7F87" Margin="0,3,0,0" FontSize="12" />
                    </StackPanel>
                    <CheckBox x:Name="StartInTrayCheckBox" Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0" />
                </Grid>
            </Border>

            <Border BorderBrush="#E6E8EB" BorderThickness="1" CornerRadius="10" Background="#FFFFFF" Padding="14" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="계정" FontWeight="SemiBold" />
                        <TextBlock Text="Instagram 계정 전환 창을 엽니다. 로그인은 Instagram 화면에서 직접 진행됩니다." Foreground="#7A7F87" Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button x:Name="SwitchAccountButton" Content="계정 전환" Height="30" Padding="12,0" Margin="0,0,6,0" Click="SwitchAccountButton_Click" />
                        <Button x:Name="LogoutButton" Content="로그아웃" Height="30" Padding="12,0" Click="LogoutButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border BorderBrush="#E6E8EB" BorderThickness="1" CornerRadius="10" Background="#FFFFFF" Padding="14" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="알림 받기" FontWeight="SemiBold" />
                        <TextBlock Text="새 DM이 오면 Windows 알림을 표시합니다." Foreground="#7A7F87" Margin="0,3,0,0" FontSize="12" />
                    </StackPanel>
                    <CheckBox x:Name="NotificationEnabledCheckBox" Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0" Checked="NotificationEnabledCheckBox_Changed" Unchecked="NotificationEnabledCheckBox_Changed" />
                </Grid>
            </Border>

            <Border BorderBrush="#E6E8EB" BorderThickness="1" CornerRadius="10" Background="#FFFFFF" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="알림에 메시지 내용 표시" FontWeight="SemiBold" />
                        <TextBlock Text="끄면 보낸 사람만 표시하고 내용은 숨깁니다." Foreground="#7A7F87" Margin="0,3,0,0" FontSize="12" />
                    </StackPanel>
                    <CheckBox x:Name="NotificationPreviewCheckBox" Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0" />
                </Grid>
            </Border>
        </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="3" VerticalAlignment="Bottom" Foreground="#8A909A" FontSize="11" TextWrapping="Wrap"
                   Text="OnlyDM is an unofficial project and is not affiliated with Instagram or Meta." Margin="0,16,0,0" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="취소" Width="86" Height="34" Margin="0,0,8,0" Click="CancelButton_Click" />
            <Button x:Name="SaveButton" Content="저장" Width="86" Height="34" Click="SaveButton_Click" Background="#2563EB" Foreground="White" BorderThickness="0" />
        </StackPanel>
    </Grid>
</Window>

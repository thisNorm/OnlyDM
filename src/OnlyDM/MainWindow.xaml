<Window x:Class="OnlyDM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        WindowStyle="None"
        Title="OnlyDM"
        Width="390"
        Height="720"
        MinWidth="340"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/OnlyDM.ico"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <!-- Frameless like a desktop messenger, but Aero snap and resize borders still work.
             CaptionHeight matches the header row so it stays draggable. -->
        <shell:WindowChrome CaptionHeight="64" ResizeBorderThickness="4"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid x:Name="RootGrid">
        <!-- 4px gutter: the WebView is a child window that swallows edge hit-testing,
             which would leave the window unresizable from the right and bottom. -->
        <Grid x:Name="ContentFrame" Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="58" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="RailBorder" Grid.Column="0" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="58" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="58" />
                </Grid.RowDefinitions>
                <Image Source="Assets/OnlyDM.png" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Button Grid.Row="2" VerticalAlignment="Top" Height="58" x:Name="ChatButton" ToolTip="채팅" Content="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="19" BorderThickness="0" Background="Transparent" Click="ChatButton_Click" />
                <Button Grid.Row="1" x:Name="FriendsButton" ToolTip="친구" Content="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="19" BorderThickness="0" Background="Transparent" VerticalAlignment="Top" Height="58" Click="FriendsButton_Click" />
                <Button Grid.Row="3" x:Name="SettingsButton" ToolTip="설정" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="19" BorderThickness="0" Background="Transparent" Click="SettingsButton_Click" />
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="HeaderBorder" Grid.Row="0" BorderThickness="0,0,0,1" Padding="18,0">
                <Grid>
                    <TextBlock Text="채팅" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderHint" Text="더블클릭으로 새 채팅창" VerticalAlignment="Center" FontSize="10" Margin="0,0,10,0" />
                        <Button x:Name="NewChatButton" ToolTip="새 채팅" Content="&#xE932;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                Width="32" Height="28" BorderThickness="0" Background="Transparent"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="NewChatButton_Click" />
                        <Button x:Name="MinimizeButton" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                Width="32" Height="28" BorderThickness="0" Background="Transparent"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MinimizeButton_Click" />
                        <Button x:Name="CloseButton" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                Width="32" Height="28" BorderThickness="0" Background="Transparent"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="SearchPanel" Grid.Row="1" Padding="12,10" BorderThickness="0,0,0,1">
                <Grid>
                    <Border x:Name="SearchBoxBorder" CornerRadius="10" Padding="10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                            <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                     FontSize="14" VerticalContentAlignment="Center" Padding="4,8"
                                     ToolTip="채팅 검색" TextChanged="SearchBox_TextChanged" />
                            <Button Grid.Column="2" Content="×" BorderThickness="0" Background="Transparent" FontSize="18" Click="ClearSearchButton_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="2" x:Name="BrowserBorder">
                <Grid>
                    <wv2:WebView2 x:Name="Browser" Visibility="Hidden" IsHitTestVisible="False" />
                    <!-- Second view so opening the friends list never discards the
                         conversations already harvested in the inbox view. -->
                    <wv2:WebView2 x:Name="FriendsBrowser" Visibility="Collapsed" IsHitTestVisible="False" />
                    <Grid x:Name="InboxLoadingPanel" Background="Transparent">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar Width="120" Height="3" IsIndeterminate="True" />
                            <TextBlock x:Name="ProjectionStatusText" Text="채팅 목록을 불러오는 중입니다." Margin="0,12,0,0"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       MaxWidth="250" FontSize="12" Opacity="0.65" />
                            <Button x:Name="ProjectionRetryButton" Content="다시 시도" Margin="0,12,0,0" Padding="14,6"
                                    HorizontalAlignment="Center" Visibility="Collapsed" Click="ProjectionRetryButton_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</Window>
